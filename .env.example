# Argus-Breakout — environment configuration (copy to .env; never commit .env)
# All values are placeholders. See docs/architecture/DESIGN.md §10.

# Storage / output (relative to PROJECT_ROOT or absolute)
ARGUS_STORE_DIR=store
ARGUS_OUT_DIR=out
ARGUS_LOG_LEVEL=INFO

# Polygon.io (nightly grouped-daily bars, splits, dividends)
POLYGON_API_KEY=replace-me

# Financial Modeling Prep (constituents, profiles, calendars)
FMP_API_KEY=replace-me
FMP_DAILY_CALL_BUDGET=200

# Interactive Brokers — PAPER gateway only (ADR-0006)
IB_HOST=127.0.0.1
IB_PORT=<paper-gateway-port>
IB_CLIENT_ID=11
IB_CLIENT_ID_WRITE=12

# Local model gateway (OpenAI-compatible; used from PID-ARGUS-0003)
LLM_BASE_URL=<http://gateway-host:port/v1>
LLM_API_KEY=replace-me
LLM_MODEL_BRIEF=<alias-of-30B-class-model>
LLM_MODEL_REVIEW=<alias-of-reasoning-model>
LLM_MODEL_FAST=<alias-of-fast-model>
LLM_MODEL_EMBED=<alias-of-embedding-model>
