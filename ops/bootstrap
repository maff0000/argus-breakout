#!/usr/bin/env bash
# Argus-Breakout bootstrap: verify gitleaks is installed and activate the
# committed pre-commit hook via core.hooksPath. Installs nothing itself.
# Public repository: commits are BLOCKED without a working secret scanner.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "bootstrap: gitleaks not found on PATH. Install from https://github.com/gitleaks/gitleaks/releases" >&2
  exit 1
fi
git config core.hooksPath scripts/hooks
chmod +x scripts/hooks/pre-commit
echo "bootstrap: core.hooksPath=scripts/hooks; gitleaks $(gitleaks version 2>/dev/null | head -1)"
