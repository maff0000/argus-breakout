# secrets and local config
.env
.env.*
!.env.example
# data and outputs (host only)
store/
out/
*.duckdb
*.duckdb.wal
# python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
# editors / os
.idea/
.vscode/
.DS_Store
# credential-shaped files (never commit)
# Placed AFTER the secrets block above so the `!.env.example` negation there
# keeps working: `.env.example` stays tracked and is not matched below.
# A real documentation .txt in the repository root must be added with
# `git add -f` and a reviewer's attention.
*.key
*.pem
*.p12
*.pfx
*.jks
*secret*
*credential*
*apikey*
*api-key*
*api_key*
*token*
/*.txt
# Governance documents must never be silently ignored (AMD-0007): they reach
# main by direct commit, so a name containing "secret" or "token" must not hide
# one. These negations come AFTER the credential patterns above and do not
# re-include .env.
!/docs/**
!/*.md
